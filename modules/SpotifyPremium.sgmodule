#!name = Spotify Premium & PAM Badge
#!desc = Mở khóa tính năng Spotify, hiển thị huy hiệu Premium và chặn quảng cáo

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del if-none-match

[Script]
# 1. Đổi platform iPhone sang iPad để chọn bài tùy ý
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://cdn.jsdelivr.net/gh/dinhduyvinh09/AppPre@refs/heads/main/js/spotify-json.js

# 2. Xử lý Protobuf: Bootstrap, Customize và PAM Badge (đã mở rộng bắt pam-view-service/)
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|pam-view-service\/),requires-body=1,binary-body-mode=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/dinhduyvinh09/AppPre@refs/heads/main/js/spotify-proto.js,script-update-interval=0

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com, *spclient.spotify.com